{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "esports-simulator-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/rpc/*", "/api/*", "/api-reference", "/api-reference/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worlds-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/src/d1/migrations"
    }
  ],
  "vars": { "PUBLIC_URL": "http://localhost:3101" }
}
